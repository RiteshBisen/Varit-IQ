# ──────────────────────────────────────────────────────
# MCQ Generator — Backend Environment Variables
# Copy this file to `.env` and fill in the values.
# ──────────────────────────────────────────────────────

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Google Gemini Model ID (e.g. gemini-flash-latest, gemini-2.5-flash)
# Defaults to gemini-flash-latest (stable, high free-tier limits)
GEMINI_MODEL_ID=gemini-flash-latest

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# SMTP Mail Forwarding Configuration (Optional, falls back to Mock Mode if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_EMAIL=supportvaritiq@gmail.com

# Resend API Configuration (Alternative to SMTP, recommended for Render Free tier)
# Get your free key at: https://resend.com
RESEND_API_KEY=
# Optional: Verified sender email domain. Default is "Varit IQ Support <onboarding@resend.dev>"
RESEND_FROM_EMAIL=

